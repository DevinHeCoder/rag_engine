# ==================== RAG Engine .gitignore ====================

# 敏感信息：API 密钥（.env.example 是可提交的模板，勿删）
.env
.env.local
.env.*.local

# 虚拟环境
.venv/
venv/
env/
ENV/

# IDE
.idea/
.vscode/
*.swp

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# 测试与工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 运行时产物（日志、挂载数据）
logs/
data/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 本地调试/临时脚本与截帧（不进版本库）
_*.py
_*.json
_*.png
_frames/
_frames2/
*.mp4

# 本地大文件（视频已部署到服务器）
rag_engine_demo.mp4

# 本地演示视频与营销落地页（不进公开仓库）
landing/

# 个人面试/简历材料
docs/*.docx

# API key 临时文件
_current_key.txt

# 商务模板（含报价/合同信息，不进公开仓库）
business_templates/
