# ==================== .env 示例 ====================
# 复制为 .env 后按需填写（docker compose 会自动读取）
# 配置优先级：环境变量 > .env > config/settings.yaml 默认值

# LLM 供应商（OpenAI 兼容）
RAG_LLM_BASE_URL=https://api.deepseek.com
RAG_LLM_API_KEY=sk-your-key-here
RAG_LLM_MODEL=deepseek-chat
RAG_LLM_EMBEDDING_MODEL=deepseek-text-embedding-v2

# 可插拔选型（可选，默认 hybrid / fixed）
RAG_RETRIEVAL__RETRIEVER=hybrid
RAG_INGESTION__CHUNKER=fixed

# Milvus 向量数据库（可选：启用 retrieval.retriever=milvus 时需要）
# 本地未起 Milvus 服务时保持默认即可；Docker 方式见 docker-compose.milvus.yml
MILVUS_HOST=localhost
MILVUS_PORT=19530
# MILVUS_USER=
# MILVUS_PASSWORD=
# MILVUS_DATABASE=default